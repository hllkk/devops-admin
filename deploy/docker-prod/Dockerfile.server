# syntax=docker/dockerfile:1
# ============================================================================
# devops-admin 后端生产镜像（多阶段）
#
#   构建上下文（compose context）：仓库 server/ 目录
#   构建：golang:1.26-alpine
#   运行：alpine:3.20（非 root，最小权限）
#
# 配置注入：compose 把宿主 config.yaml 挂载到 /app/config/config.yaml（:ro），
#          敏感项（DB/Redis/JWT/RustFS 密码、可信反代）由 initialize/other.go 的
#          applyEnvOverrides 用环境变量覆盖，config.yaml 静态入库无需编辑。
# 注意：Dockerfile 位于 context（server/）之外，依赖 BuildKit（现代 Docker 默认开启）。
# ============================================================================

# ----------------------------------------------------------------------------
# 阶段 1：编译静态二进制
# ----------------------------------------------------------------------------
FROM golang:1.26-alpine AS builder

# 国内构建走 goproxy.cn 加速；外网构建可在 compose 用 build.args.GOPROXY 覆盖
ARG GOPROXY=https://goproxy.cn,direct
# 版本注入：与镜像版本化 tag 共用 APP_VERSION（compose 传参），
# 注入 global.Version/BuildTime 供在线升级比对与「关于」展示
ARG APP_VERSION=dev
ARG BUILD_TIME=unknown
ENV CGO_ENABLED=0 \
    GOPROXY=${GOPROXY}

WORKDIR /build

# 先拷依赖清单，命中 docker 层缓存
COPY go.mod go.sum ./
RUN go mod download

# 拷源码（含已入库的 docs/docs.go、docs/swagger.json 与 resource/ip2region.xdb）
COPY . .

# 静态编译，剥离调试信息与路径，缩小体积；版本经 ldflags 注入 global
RUN go build -trimpath \
    -ldflags="-s -w -X 'github.com/hllkk/devops-admin/server/global.Version=${APP_VERSION}' -X 'github.com/hllkk/devops-admin/server/global.BuildTime=${BUILD_TIME}'" \
    -o /out/devops-admin-server .

# node_exporter 官方二进制下载到托管目录(安装流按架构选用: resource/node-exporter/node_exporter-<arch>)
# 多源回退:官方 release 直连 → gh-proxy 国内代理;GOPROXY 同构建参数
# alpine 基础镜像无 curl(退出码 127)，先装；apk 走清华源对齐 Dockerfile.web 的国内构建加速
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories \
    && apk add --no-cache curl ca-certificates
RUN set -eux; \
    mkdir -p /out/agent; \
    for arch in amd64 arm64; do \
        ver="1.9.1"; \
        file="node_exporter-${ver}.linux-${arch}.tar.gz"; \
        if ! curl -fsSL --retry 2 -o /tmp/${file} "https://github.com/prometheus/node_exporter/releases/download/v${ver}/${file}"; then \
            curl -fsSL --retry 3 -o /tmp/${file} "https://gh-proxy.com/https://github.com/prometheus/node_exporter/releases/download/v${ver}/${file}"; \
        fi; \
        tar -xzf /tmp/${file} -C /tmp; \
        mv "/tmp/node_exporter-${ver}.linux-${arch}/node_exporter" "/out/agent/node_exporter-${arch}"; \
        rm -rf /tmp/${file} "/tmp/node_exporter-${ver}.linux-${arch}"; \
    done

# ----------------------------------------------------------------------------
# 阶段 2：最小运行镜像
# ----------------------------------------------------------------------------
FROM alpine:3.20

# ca-certificates：rustfs / aws-sdk 走 HTTPS 需要根证书；tzdata：Asia/Shanghai
RUN apk add --no-cache ca-certificates tzdata && update-ca-certificates

# 非 root 运行（最小权限，符合生产安全要求）
RUN addgroup -S app && adduser -S -G app app

ENV TZ=Asia/Shanghai \
    OPS_CONFIG=/app/config/config.yaml

WORKDIR /app

# 二进制 + 运行时资源（ip2region.xdb 由 config.system.ip2region-db-path 相对引用）
COPY --from=builder /out/devops-admin-server /app/server
COPY --from=builder /build/resource /app/resource
# agent 托管二进制(安装流按目标架构选用;resource 卷对宿主挂载时不覆盖此目录)
COPY --from=builder /out/agent /app/resource/agent

RUN chown -R app:app /app

USER app

EXPOSE 8888

ENTRYPOINT ["/app/server"]
