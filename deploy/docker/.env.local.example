# 生产环境覆盖配置
# 复制此文件为 .env.local 并填入实际值
# .env.local 已被 .gitignore 忽略，不会被提交到 git
#
# 企业微信登录凭证现由「系统设置 → 认证 → 企业微信」页面配置（数据库存储），无需在此填写。

# JWT 签名密钥（必须设置）— 生成命令: openssl rand -hex 32
JWT_SIGNING_KEY=

# OnlyOffice 文档服务 JWT 密钥（须与数据库「系统设置→OnlyOffice→tokenSecret」一致）
# 生成命令: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=

# Cookie Secure 标志：HTTPS 环境必须设为 true，HTTP 本地开发设为 false
COOKIE_SECURE=false
