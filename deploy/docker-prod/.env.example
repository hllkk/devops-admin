# ============================================================================
# devops-admin 生产环境机密配置（docker compose 层）
#
# 用法：
#   cp .env.example .env
#   填入强随机值后：docker compose up -d --build
#
# 维护说明（已精简，只维护本文件）：
#   - 本文件是唯一机密源；后端 initialize/other.go 启动时用 env 覆盖 config.yaml
#     的对应字段（DB/Redis/JWT/RustFS 密码、可信反代），无需在 config.yaml 重复填写或同步
#   - config.yaml 是静态入库配置（密码为占位默认值，由 env 覆盖），无需编辑
#   - .env 不提交仓库（根 .gitignore 已忽略 deploy/docker-prod/.env）
# ============================================================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 构建参数（外网环境可改 GOPROXY=https://proxy.golang.org,direct）----
GOPROXY=https://goproxy.cn,direct

# ---- 版本号（在线升级/镜像版本化 tag 用，默认 prod 保持手工部署行为）----
# 发布构建（deploy/release/build-release.sh）会写入具体版本号并产出同名版本化镜像 tag：
#   devops-admin/web|server|updater:<版本>；升级 = .env 换新版本号 + up -d
# 回滚 = 改回旧版本号再 up -d（旧版本镜像保留在本地不被覆盖）
APP_VERSION=prod
BUILD_TIME=unknown

# ---- 对外端口 ----
WEB_PORT=80
# 后端直接暴露端口；生产建议仅经 web 反代访问，需要时放开，否则注释下行
SERVER_PORT=8888

# ============ 必填（留空则 docker compose up 报错）===========

# JWT 签名密钥（至少 32 字符）— 生成: openssl rand -hex 32
# 生产强制（GIN_MODE=release 下 other.go 校验，默认/弱密钥会 Fatal）
JWT_SIGNING_KEY=

# 系统初始化超级管理员密码（首次 /init/autoInitDB 生效）
INIT_ADMIN_PASSWORD=

# ============ 基础设施账号密码（由 env 覆盖进 config，无需同步 config.yaml）===========

POSTGRES_USER=devops
POSTGRES_PASSWORD=
POSTGRES_DB=devops_admin
PG_DATA_PATH=/home/docker/docker-prod/pgsql

REDIS_PASSWORD=
REDIS_DATA_PATH=/home/docker/docker-prod/redis

# RustFS（S3 兼容对象存储，与 dev 一致）；镜像 tag 生产建议固定为具体版本而非 latest
RUSTFS_VERSION=latest
MC_VERSION=latest
RUSTFS_ROOT_USER=devops-admin
# 长度 >= 8
RUSTFS_ROOT_PASSWORD=
RUSTFS_BUCKET=devops-admin
RUSTFS_DATA_PATH=/home/docker/docker-prod/rustfs

# ============ AI 网关 LiteLLM 底座 ============
# LiteLLM 管理面 + 虚拟 Key 鉴权密钥（sk- 前缀，至少 32 字符）— 生成: openssl rand -hex 32
LITELLM_MASTER_KEY=
# LiteLLM 虚拟 Key 加密盐值（至少 32 字符）— 生成: openssl rand -hex 32
LITELLM_SALT_KEY=
# LiteLLM 宿主直连端口映射（默认仅本机回环 127.0.0.1:4000，安全等同不映射）；
# 客户端常规接入走 nginx /llm/ 反代，无需宿主端口。
# 宿主 4000 被其它 litellm 占用时过渡方案：设 4001，待旧实例停用后改回 4000
# 并 docker compose up -d（容器网内恒为 litellm:4000，base-url/反代不受影响）
# 需对局域网开放时写 0.0.0.0:4001
LITELLM_HOST_PORT=127.0.0.1:4000
# 客户端转发接入点（员工拿到的接入地址；经 nginx /llm/ 反代或直暴露 4000，留空则不下发）
# 建议用 /llm 反代形式（http://<部署IP>/llm）：换宿主端口/切 4000 时接入地址无感
LITELLM_PUBLIC_URL=

# ============ 应用运行时配置 ============

# 可信反代 CIDR/IP（逗号分隔），多层反代下正确解析真实客户端 IP
# 反代部署必须配置，否则登录日志/限流 IP 显示为代理 IP
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32,::1/128

# ---- server 持久化路径（本地上传文件、运行日志）----
SERVER_UPLOADS_PATH=/home/docker/docker-prod/uploads
SERVER_LOG_PATH=/home/docker/docker-prod/server-log

# ---- 在线升级（系统设置「关于」→ 检查更新；留空 = 不启用，检查更新仅提示未配置）----
# 发布服务器根地址（nginx 静态托管，其下 manifest.json 描述最新版本与升级包；
# 多项目共用一台发布服务器时按子目录区分，如 http://<host>/devops-admin）
UPDATE_SERVER_URL=
# 升级执行器(updater sidecar)写接口鉴权 token（与下方 UPDATER_TOKEN 同源；留空 = 内网不鉴权）
# 生成: openssl rand -hex 16
UPDATER_TOKEN=
