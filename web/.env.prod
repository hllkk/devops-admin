# backend service base url, prod environment
# 生产同源反代：nginx 把 /proxy-default 反代到后端 server:8888（与 dev 的 vite proxy 一致）
# 若前后端分域名部署，改为后端完整地址，如 https://api.example.com
VITE_SERVICE_BASE_URL=/proxy-default

# other backend service base url, prod environment
# demo 为示例多服务前缀，未启用可保留；nginx 默认仅反代 /proxy-default
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "/proxy-demo"
}`
