# DevOps Admin Docker 环境变量
# 复制此文件为 .env 并修改密码
#
# !!! 重要 !!!
# 修改以下密码后，必须同步修改 conf/config.yaml 中对应的值：
#   MYSQL_ROOT_PASSWORD → config.yaml 中 mysql.password
#   REDIS_PASSWORD      → config.yaml 中 redis.password 和 redis-list[0].password
#   RUSTFS_ROOT_USER    → config.yaml 中 rustfs.access-key-id
#   RUSTFS_ROOT_PASSWORD→ config.yaml 中 rustfs.secret-access-key

MYSQL_ROOT_PASSWORD=devops_admin_2026
REDIS_PASSWORD=devops_redis_2026
RUSTFS_ROOT_USER=devops-admin
RUSTFS_ROOT_PASSWORD=devops_rustfs_2026
INIT_ADMIN_PASSWORD=admin@123
